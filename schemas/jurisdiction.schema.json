{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/jurisdiction.schema.json",
  "title": "JurisdictionConfig",
  "description": "Configuration contract for a jurisdiction in jurisdictions/<id>.yaml (Schema v1.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "state",
    "building_types",
    "parents",
    "documents",
    "maps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2",
      "default": "1.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase hyphenated hierarchical jurisdiction ID."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional alternative display or search names for the jurisdiction."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "test"],
      "default": "public",
      "description": "Visibility of the jurisdiction in production vs preview/test environments."
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "default": "CC BY 4.0",
      "description": "Open data licence identifier for published releases of this jurisdiction."
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter uppercase country code."
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,4}$",
      "description": "Uppercase state or territory code."
    },
    "building_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "not_modelled": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Regulatory domains or layers intentionally excluded from this jurisdiction dataset."
    },
    "unread_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unreadDocumentConfig"
      },
      "description": "Known documents or circulars not yet ingested in this release."
    },
    "unobtainable_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unobtainableDocumentConfig"
      },
      "description": "Documents identified during discovery that could not be obtained from official or mirror sources."
    },
    "contested_status": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contestedStatusConfig"
      },
      "description": "Documents whose legal status has conflicting evidence and is declared status_unknown."
    },
    "building_relevant_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Map of doc_id to building-relevant section or chapter numbers."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/documentConfig"
      }
    },
    "maps": {
      "type": "object",
      "title": "MapsConfig",
      "additionalProperties": false,
      "required": ["boundaries", "zoning"],
      "properties": {
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryMapConfig"
          }
        },
        "planning_districts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planningDistrictMapConfig"
          }
        },
        "zoning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zoningMapConfig"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlayMapConfig"
          }
        }
      }
    }
  },
  "$defs": {
    "statusEvidenceConfig": {
      "type": "object",
      "title": "StatusEvidenceConfig",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": ["string", "null"]
        },
        "quoted_line": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "textRightsConfig": {
      "type": "object",
      "title": "TextRightsConfig",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["full_text", "reference_only"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citedProvisionConfig": {
      "type": "object",
      "title": "CitedProvisionConfig",
      "additionalProperties": false,
      "required": ["clause", "cited_by"],
      "properties": {
        "part": {
          "type": ["string", "null"]
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": ["string", "null"]
        },
        "cited_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "where_to_obtain": {
          "type": ["string", "null"]
        }
      }
    },
    "unreadDocumentConfig": {
      "type": "object",
      "title": "UnreadDocumentConfig",
      "additionalProperties": false,
      "required": ["title", "source_url", "reason"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unobtainableDocumentConfig": {
      "type": "object",
      "title": "UnobtainableDocumentConfig",
      "additionalProperties": false,
      "required": ["id", "title", "searched_sources", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "searched_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contestedStatusConfig": {
      "type": "object",
      "title": "ContestedStatusConfig",
      "additionalProperties": false,
      "required": ["doc_id", "title", "declared_status", "conflicting_evidence"],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "declared_status": {
          "type": "string",
          "const": "status_unknown"
        },
        "conflicting_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documentConfig": {
      "type": "object",
      "title": "DocumentConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "issuing_authority",
        "layer",
        "legal_status",
        "status_evidence",
        "licence_or_terms",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "issuing_authority": {
          "type": "string",
          "minLength": 1
        },
        "doc_type": {
          "type": "string",
          "enum": [
            "act",
            "rules",
            "regulations",
            "bye_laws",
            "amendment",
            "notification",
            "government_order",
            "circular",
            "map",
            "standard_reference"
          ]
        },
        "layer": {
          "type": "string",
          "enum": [
            "statute",
            "state_rules",
            "planning",
            "municipal",
            "orders",
            "overlay",
            "national_reference",
            "boundary"
          ]
        },
        "legal_status": {
          "type": "string",
          "enum": [
            "in_force",
            "draft",
            "superseded",
            "withdrawn",
            "status_unknown"
          ]
        },
        "status_evidence": {
          "$ref": "#/$defs/statusEvidenceConfig"
        },
        "notification_number": {
          "type": ["string", "null"]
        },
        "gazette_reference": {
          "type": ["string", "null"]
        },
        "superseded_by_document": {
          "type": ["string", "null"]
        },
        "licence_or_terms": {
          "type": "string",
          "minLength": 1
        },
        "text_rights": {
          "$ref": "#/$defs/textRightsConfig"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["en", "kn"]
          }
        },
        "role": {
          "type": "string",
          "enum": ["base", "amendment", "regulation", "boundary", "reference"]
        },
        "official_url": {
          "type": ["string", "null"]
        },
        "mirror_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "notified_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effective_from": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "amends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cited_provisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citedProvisionConfig"
          }
        }
      }
    },
    "boundaryMapConfig": {
      "type": "object",
      "title": "BoundaryMapConfig",
      "additionalProperties": false,
      "required": ["id", "source_url", "select"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "layer_role": {
          "type": "string",
          "enum": ["corporation", "gba_zones", "wards"]
        },
        "output_file": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "select": {
          "type": "object",
          "title": "BoundarySelectRule",
          "additionalProperties": false,
          "required": ["property", "equals"],
          "properties": {
            "property": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "planningDistrictMapConfig": {
      "type": "object",
      "title": "PlanningDistrictMapConfig",
      "additionalProperties": false,
      "required": ["id", "source_url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "district_code_field": {
          "type": "string"
        },
        "district_name_field": {
          "type": "string"
        },
        "source_attribution": {
          "type": "string"
        }
      }
    },
    "tracedZoningMapConfig": {
      "type": "object",
      "title": "TracedZoningMapConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "document",
        "page",
        "planning_district",
        "legend_page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "traced",
            "vector_pdf",
            "grid_georeferenced_raster",
            "osm_gcp_raster"
          ]
        },
        "document": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "planning_district": {
          "type": ["integer", "string"]
        },
        "sheet": {
          "type": ["string", "null"]
        },
        "legend_page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_url": {
          "type": ["string", "null"]
        }
      }
    },
    "importedZoningMapConfig": {
      "type": "object",
      "title": "ImportedZoningMapConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_url",
        "zone_code_field",
        "zone_label_field",
        "source_attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "const": "imported"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "zone_code_field": {
          "type": "string",
          "minLength": 1
        },
        "zone_label_field": {
          "type": "string",
          "minLength": 1
        },
        "planning_district": {
          "type": ["string", "null"]
        },
        "sheet": {
          "type": ["string", "null"]
        },
        "source_attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zoningMapConfig": {
      "title": "ZoningMapConfig",
      "oneOf": [
        {
          "$ref": "#/$defs/tracedZoningMapConfig"
        },
        {
          "$ref": "#/$defs/importedZoningMapConfig"
        }
      ]
    },
    "overlayMapConfig": {
      "type": "object",
      "title": "OverlayMapConfig",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "source", "method"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["derived_overlay", "reference"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "accuracy_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "derived": {
          "type": "boolean",
          "default": true
        },
        "buffer_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "source_url": {
          "type": ["string", "null"]
        },
        "external_url": {
          "type": ["string", "null"]
        },
        "rule_doc_id": {
          "type": ["string", "null"]
        },
        "rule_clause": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
