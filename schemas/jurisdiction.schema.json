{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/jurisdiction.schema.json",
  "title": "JurisdictionConfig",
  "description": "Configuration contract for a jurisdiction in jurisdictions/<id>.yaml (Schema v1.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "state",
    "building_types",
    "parents",
    "documents",
    "maps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase hyphenated hierarchical jurisdiction ID (e.g. xx-test-fixture)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional alternative display or search names for the jurisdiction."
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter uppercase country code."
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,4}$",
      "description": "Uppercase state or territory code."
    },
    "building_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "not_modelled": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Regulatory domains or layers intentionally excluded from this jurisdiction dataset."
    },
    "unread_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unreadDocumentConfig"
      },
      "description": "Known documents or circulars not yet ingested in this release."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/documentConfig"
      }
    },
    "maps": {
      "type": "object",
      "title": "MapsConfig",
      "additionalProperties": false,
      "required": ["boundaries", "zoning"],
      "properties": {
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryMapConfig"
          }
        },
        "zoning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zoningMapConfig"
          }
        }
      }
    }
  },
  "$defs": {
    "statusEvidenceConfig": {
      "type": "object",
      "title": "StatusEvidenceConfig",
      "additionalProperties": false,
      "required": ["url", "description"],
      "properties": {
        "url": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unreadDocumentConfig": {
      "type": "object",
      "title": "UnreadDocumentConfig",
      "additionalProperties": false,
      "required": ["title", "source_url", "reason"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documentConfig": {
      "type": "object",
      "title": "DocumentConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "issuing_authority",
        "layer",
        "legal_status",
        "status_evidence",
        "licence_or_terms",
        "role",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "issuing_authority": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": ["national", "state", "planning", "municipal"]
        },
        "legal_status": {
          "type": "string",
          "enum": ["in_force", "draft", "superseded", "withdrawn"]
        },
        "status_evidence": {
          "$ref": "#/$defs/statusEvidenceConfig"
        },
        "licence_or_terms": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["base", "amendment", "regulation", "boundary", "reference"]
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "notified_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effective_from": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "amends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "boundaryMapConfig": {
      "type": "object",
      "title": "BoundaryMapConfig",
      "additionalProperties": false,
      "required": ["id", "source_url", "select"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "select": {
          "type": "object",
          "title": "BoundarySelectRule",
          "additionalProperties": false,
          "required": ["property", "equals"],
          "properties": {
            "property": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tracedZoningMapConfig": {
      "type": "object",
      "title": "TracedZoningMapConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "document",
        "page",
        "planning_district",
        "legend_page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "const": "traced"
        },
        "document": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "planning_district": {
          "type": ["integer", "string"]
        },
        "legend_page": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "importedZoningMapConfig": {
      "type": "object",
      "title": "ImportedZoningMapConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_url",
        "zone_code_field",
        "zone_label_field",
        "source_attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "const": "imported"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "zone_code_field": {
          "type": "string",
          "minLength": 1
        },
        "zone_label_field": {
          "type": "string",
          "minLength": 1
        },
        "source_attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zoningMapConfig": {
      "title": "ZoningMapConfig",
      "oneOf": [
        {
          "$ref": "#/$defs/tracedZoningMapConfig"
        },
        {
          "$ref": "#/$defs/importedZoningMapConfig"
        }
      ]
    }
  }
}
