{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/jurisdiction.schema.json",
  "title": "JurisdictionConfig",
  "description": "Configuration contract for a jurisdiction in jurisdictions/<id>.yaml (Schema v1.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country",
    "state",
    "building_types",
    "parents",
    "documents",
    "maps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4",
      "default": "1.4"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase hyphenated hierarchical jurisdiction ID."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional alternative display or search names for the jurisdiction."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "test"],
      "default": "public",
      "description": "Visibility of the jurisdiction in production vs preview/test environments."
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "default": "CC BY 4.0",
      "description": "Open data licence identifier for published releases of this jurisdiction."
    },
    "release_version": {
      "type": ["string", "null"],
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version for the published release of this jurisdiction."
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter uppercase country code."
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,4}$",
      "description": "Uppercase state or territory code."
    },
    "building_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parent": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Optional parent jurisdiction ID for a child municipal corporation."
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "not_modelled": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Regulatory domains or layers intentionally excluded from this jurisdiction dataset."
    },
    "unread_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unreadDocumentConfig"
      },
      "description": "Known documents or circulars not yet ingested in this release."
    },
    "unobtainable_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unobtainableDocumentConfig"
      },
      "description": "Documents identified during discovery that could not be obtained from official or mirror sources."
    },
    "contested_status": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contestedStatusConfig"
      },
      "description": "Documents whose legal status has conflicting evidence and is declared status_unknown."
    },
    "building_relevant_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Map of doc_id to building-relevant section or chapter numbers."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/documentConfig"
      }
    },
    "amendment_links": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "JurisdictionAmendmentLinkConfig",
        "additionalProperties": false,
        "required": [
          "amending_clause",
          "target_clause",
          "action",
          "confidence",
          "verification"
        ],
        "properties": {
          "amending_clause": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
          },
          "target_clause": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
          },
          "action": {
            "type": "string",
            "enum": [
              "substitute",
              "insert_after",
              "insert_before",
              "omit",
              "modify",
              "renumber"
            ]
          },
          "effective_date": {
            "type": ["string", "null"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "verification": {
            "type": "string",
            "enum": ["unverified", "machine_checked", "human_verified"]
          },
          "note": {
            "type": ["string", "null"]
          },
          "replacement_text": {
            "type": ["string", "null"]
          },
          "applies_in": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "maps": {
      "type": "object",
      "title": "MapsConfig",
      "additionalProperties": false,
      "required": ["boundaries", "zoning"],
      "properties": {
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundaryMapConfig"
          }
        },
        "planning_districts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planningDistrictMapConfig"
          }
        },
        "zoning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zoningMapConfig"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlayMapConfig"
          }
        }
      }
    }
  },
  "$defs": {
    "statusEvidenceConfig": {
      "type": "object",
      "title": "StatusEvidenceConfig",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": ["string", "null"]
        },
        "quoted_line": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "retrievalResponseHeaders": {
      "type": "object",
      "title": "RetrievalResponseHeaders",
      "additionalProperties": false,
      "properties": {
        "etag": {
          "type": ["string", "null"]
        },
        "last_modified": {
          "type": ["string", "null"]
        },
        "server": {
          "type": ["string", "null"]
        },
        "date": {
          "type": ["string", "null"]
        }
      }
    },
    "retrievalRecord": {
      "type": "object",
      "title": "RetrievalRecord",
      "additionalProperties": false,
      "required": [
        "fetched_at",
        "requested_url",
        "final_url",
        "http_status",
        "content_type",
        "content_length",
        "response_headers",
        "sha256",
        "fetched_by"
      ],
      "properties": {
        "fetched_at": {
          "type": "string",
          "minLength": 10
        },
        "requested_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "final_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": ["string", "null"]
        },
        "content_length": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "response_headers": {
          "$ref": "#/$defs/retrievalResponseHeaders"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archive_url": {
          "type": ["string", "null"]
        },
        "archive_failure_reason": {
          "type": ["string", "null"]
        },
        "fetched_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "textRightsConfig": {
      "type": "object",
      "title": "TextRightsConfig",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["full_text", "reference_only"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citedProvisionConfig": {
      "type": "object",
      "title": "CitedProvisionConfig",
      "additionalProperties": false,
      "required": ["clause", "cited_by"],
      "properties": {
        "part": {
          "type": ["string", "null"]
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": ["string", "null"]
        },
        "cited_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "where_to_obtain": {
          "type": ["string", "null"]
        }
      }
    },
    "unreadDocumentConfig": {
      "type": "object",
      "title": "UnreadDocumentConfig",
      "additionalProperties": false,
      "required": ["title", "source_url", "reason"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unobtainableDocumentConfig": {
      "type": "object",
      "title": "UnobtainableDocumentConfig",
      "additionalProperties": false,
      "required": ["id", "title", "searched_sources", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "searched_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contestedStatusConfig": {
      "type": "object",
      "title": "ContestedStatusConfig",
      "additionalProperties": false,
      "required": ["doc_id", "title", "declared_status", "conflicting_evidence"],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "declared_status": {
          "type": "string",
          "const": "status_unknown"
        },
        "conflicting_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documentConfig": {
      "type": "object",
      "title": "DocumentConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "issuing_authority",
        "layer",
        "legal_status",
        "status_evidence",
        "licence_or_terms",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "plain_title": {
          "type": ["string", "null"],
          "default": null
        },
        "issuing_authority": {
          "type": "string",
          "minLength": 1
        },
        "doc_type": {
          "type": "string",
          "enum": [
            "act",
            "rules",
            "regulations",
            "bye_laws",
            "amendment",
            "notification",
            "government_order",
            "circular",
            "map",
            "standard_reference"
          ]
        },
        "instrument_type": {
          "type": "string",
          "enum": [
            "instrument",
            "compilation",
            "map",
            "bill",
            "order"
          ],
          "default": "instrument"
        },
        "summary_by_site": {
          "type": ["string", "null"]
        },
        "notes_by_site": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "layer": {
          "type": "string",
          "enum": [
            "statute",
            "state_rules",
            "planning",
            "municipal",
            "orders",
            "overlay",
            "national_reference",
            "boundary"
          ]
        },
        "legal_status": {
          "type": "string",
          "enum": [
            "in_force",
            "draft",
            "superseded",
            "withdrawn",
            "status_unknown"
          ]
        },
        "acquisition_status": {
          "type": "string",
          "enum": ["acquired", "pending", "not_found", "reference_only"],
          "default": "acquired"
        },
        "structured": {
          "type": ["boolean", "null"],
          "default": true,
          "description": "Whether this document is structured into a clause tree in the current release."
        },
        "retrieval": {
          "anyOf": [
            { "$ref": "#/$defs/retrievalRecord" },
            { "type": "null" }
          ]
        },
        "status_evidence": {
          "$ref": "#/$defs/statusEvidenceConfig"
        },
        "notification_number": {
          "type": ["string", "null"]
        },
        "gazette_reference": {
          "type": ["string", "null"]
        },
        "superseded_by_document": {
          "type": ["string", "null"]
        },
        "applies_in": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "applies_to_jurisdiction": {
          "type": "object",
          "title": "DocumentApplicabilityConfig",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["yes", "no", "partly", "unknown"]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "quoted_evidence": {
              "type": ["string", "null"]
            },
            "url": {
              "type": ["string", "null"]
            }
          }
        },
        "licence_or_terms": {
          "type": "string",
          "minLength": 1
        },
        "text_rights": {
          "$ref": "#/$defs/textRightsConfig"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["en", "kn"]
          }
        },
        "role": {
          "type": "string",
          "enum": ["base", "amendment", "regulation", "boundary", "reference"]
        },
        "official_url": {
          "type": ["string", "null"]
        },
        "mirror_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "notified_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effective_from": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "amends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cited_provisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citedProvisionConfig"
          }
        }
      }
    },
    "boundaryMapConfig": {
      "type": "object",
      "title": "BoundaryMapConfig",
      "additionalProperties": false,
      "required": ["id", "source_url", "select"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "source_label": {
          "type": ["string", "null"]
        },
        "retrieved_date": {
          "type": ["string", "null"]
        },
        "verification_note": {
          "type": ["string", "null"]
        },
        "layer_role": {
          "type": "string",
          "enum": ["corporation", "gba_zones", "wards"]
        },
        "output_file": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_status": {
          "type": "string",
          "enum": ["acquired", "pending", "not_found", "reference_only"],
          "default": "acquired"
        },
        "retrieval": {
          "anyOf": [
            { "$ref": "#/$defs/retrievalRecord" },
            { "type": "null" }
          ]
        },
        "select": {
          "type": "object",
          "title": "BoundarySelectRule",
          "additionalProperties": false,
          "required": ["property", "equals"],
          "properties": {
            "property": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "planningDistrictMapConfig": {
      "type": "object",
      "title": "PlanningDistrictMapConfig",
      "additionalProperties": false,
      "required": ["id", "source_url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "district_code_field": {
          "type": "string"
        },
        "district_name_field": {
          "type": "string"
        },
        "document": {
          "type": ["string", "null"]
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "district_code": {
          "type": ["string", "null"]
        },
        "district_name": {
          "type": ["string", "null"]
        },
        "scale_m_per_pt": {
          "type": ["number", "null"]
        },
        "anchor_pdf_pt": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "anchor_utm_pt": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "source_attribution": {
          "type": "string"
        }
      }
    },
    "tracedZoningMapConfig": {
      "type": "object",
      "title": "TracedZoningMapConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "document",
        "page",
        "planning_district",
        "legend_page"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "traced",
            "vector_pdf",
            "grid_georeferenced_raster",
            "osm_gcp_raster"
          ]
        },
        "document": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "planning_district": {
          "type": ["integer", "string"]
        },
        "sheet": {
          "type": ["string", "null"]
        },
        "legend_page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_url": {
          "type": ["string", "null"]
        },
        "source_attribution": {
          "type": ["string", "null"]
        },
        "target_crs": {
          "type": "string",
          "default": "EPSG:32643"
        },
        "grid_eastings": {
          "type": ["array", "null"],
          "items": {
            "type": "number"
          }
        },
        "grid_northings": {
          "type": ["array", "null"],
          "items": {
            "type": "number"
          }
        },
        "legend_palette": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "title": "TracedLegendPaletteEntry",
            "additionalProperties": false,
            "required": ["zone_code", "zone_label", "rgbs"],
            "properties": {
              "zone_code": {
                "type": "string",
                "minLength": 1
              },
              "zone_label": {
                "type": "string",
                "minLength": 1
              },
              "rgbs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              },
              "min_area_sq_m": {
                "type": "number",
                "minimum": 0,
                "default": 1500
              },
              "morph_open_px": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              }
            }
          }
        }
      }
    },
    "importedZoningMapConfig": {
      "type": "object",
      "title": "ImportedZoningMapConfig",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_url",
        "zone_code_field",
        "zone_label_field",
        "source_attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "const": "imported"
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "zone_code_field": {
          "type": "string",
          "minLength": 1
        },
        "zone_label_field": {
          "type": "string",
          "minLength": 1
        },
        "planning_district": {
          "type": ["string", "null"]
        },
        "sheet": {
          "type": ["string", "null"]
        },
        "source_attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zoningMapConfig": {
      "title": "ZoningMapConfig",
      "oneOf": [
        {
          "$ref": "#/$defs/tracedZoningMapConfig"
        },
        {
          "$ref": "#/$defs/importedZoningMapConfig"
        }
      ]
    },
    "overlayMapConfig": {
      "type": "object",
      "title": "OverlayMapConfig",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "source", "method"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
