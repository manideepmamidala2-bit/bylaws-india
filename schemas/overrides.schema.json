{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/overrides.schema.json",
  "title": "JurisdictionOverrides",
  "description": "Versioned manual corrections, zone tags, and map curations in data/overrides/<jurisdiction>/*.yaml (Schema v1.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.3"
    },
    "clause_fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clauseFix"
      }
    },
    "annotation_fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotationFix"
      }
    },
    "zone_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoneTag"
      }
    },
    "zone_fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoneFix"
      }
    },
    "map_curations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapCuration"
      }
    },
    "amendment_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amendmentLinkOverride"
      }
    }
  },
  "$defs": {
    "clauseFix": {
      "type": "object",
      "title": "ClauseFix",
      "additionalProperties": false,
      "required": ["clause_id", "field", "value", "reason"],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "field": {
          "type": "string",
          "enum": [
            "title",
            "heading",
            "intro",
            "content",
            "wrap_up",
            "number",
            "native_number",
            "text",
            "level",
            "parent_id",
            "parent_eid",
            "verification",
            "verified_by",
            "legal_status",
            "effective_from",
            "language",
            "cross_references",
            "tables"
          ]
        },
        "value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "annotationFix": {
      "type": "object",
      "title": "AnnotationFix",
      "additionalProperties": false,
      "required": ["annotation_id", "field", "value", "reason"],
      "properties": {
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "enum": ["value", "confidence", "verification"]
        },
        "value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zoneTag": {
      "type": "object",
      "title": "ZoneTag",
      "additionalProperties": false,
      "required": ["clause_id", "zones", "reason"],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"],
          "default": "machine_checked"
        }
      }
    },
    "zoneFix": {
      "type": "object",
      "title": "ZoneFix",
      "additionalProperties": false,
      "required": ["zone_id", "set"],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:z[0-9a-zA-Z_-]+$"
        },
        "reason": {
          "type": "string"
        },
        "set": {
          "type": "object",
          "title": "ZoneFixSet",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "zone_code": {
              "type": "string",
              "minLength": 1
            },
            "zone_label": {
              "type": "string",
              "minLength": 1
            },
            "planning_district": {
              "type": ["string", "null"]
            },
            "sheet": {
              "type": ["string", "null"]
            },
            "verification": {
              "type": "string",
              "enum": [
                "unverified",
                "machine_checked",
                "human_verified",
                "rejected"
              ]
            },
            "verified_by": {
              "type": ["string", "null"]
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "mapCuration": {
      "type": "object",
      "title": "MapCuration",
      "additionalProperties": false,
      "required": ["map_id"],
      "properties": {
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "legend_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "MapLegendEntry",
            "additionalProperties": false,
            "required": ["zone_code", "zone_label", "rgb"],
            "properties": {
              "zone_code": {
                "type": "string",
                "minLength": 1
              },
              "zone_label": {
                "type": "string",
                "minLength": 1
              },
              "rgb": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        },
        "gcps": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "MapGcp",
            "additionalProperties": false,
            "required": ["id", "label", "pixel_x", "pixel_y"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "pixel_x": {
                "type": "number",
                "minimum": 0
              },
              "pixel_y": {
                "type": "number",
                "minimum": 0
              },
              "lon": {
                "type": "number"
              },
              "lat": {
                "type": "number"
              },
              "osm_query": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "amendmentLinkOverride": {
      "type": "object",
      "title": "AmendmentLinkOverride",
      "additionalProperties": false,
      "required": [
        "amending_clause",
        "target_clause",
        "action",
        "confidence",
        "verification"
      ],
      "properties": {
        "amending_clause": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "target_clause": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "action": {
          "type": "string",
          "enum": [
            "substitute",
            "insert_after",
            "insert_before",
            "omit",
            "modify",
            "renumber"
          ]
        },
        "effective_date": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        },
        "note": {
          "type": ["string", "null"]
        },
        "replacement_text": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
