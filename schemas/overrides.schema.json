{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/overrides.schema.json",
  "title": "JurisdictionOverrides",
  "description": "Versioned manual corrections, annotation fixes, zone tags, and map curations in data/overrides/<jurisdiction>/*.yaml (Schema v1.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "clause_fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clauseFix"
      }
    },
    "annotation_fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotationFix"
      }
    },
    "zone_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoneTag"
      }
    },
    "zone_fixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoneFix"
      }
    },
    "map_curations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapCuration"
      }
    },
    "amendment_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amendmentLinkOverride"
      }
    },
    "ocr_corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ocrCorrectionOverride"
      }
    },
    "unreadable_fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unreadableFragmentOverride"
      }
    },
    "table_overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tableOverride"
      }
    },
    "human_verifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanVerificationOverride"
      }
    }
  },
  "$defs": {
    "humanVerificationOverride": {
      "type": "object",
      "title": "HumanVerificationOverride",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_kind",
        "verifier_name",
        "institution",
        "verified_at",
        "verdict"
      ],
      "properties": {
        "task_id": {
          "type": ["string", "null"]
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "record_kind": {
          "type": "string",
          "enum": ["provision", "parameter", "zone"]
        },
        "verifier_name": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": ["match", "mismatch", "cant_tell"]
        },
        "note": {
          "type": ["string", "null"]
        }
      }
    },
    "unreadableFragmentOverride": {
      "type": "object",
      "title": "UnreadableFragmentOverride",
      "additionalProperties": false,
      "required": ["doc_id", "page", "raw_fragment", "reason"],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "raw_fragment": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "default": "[unreadable in source]"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tableOverride": {
      "type": "object",
      "title": "TableOverride",
      "additionalProperties": false,
      "required": ["doc_id", "page", "table_id", "caption", "headers", "rows", "reason"],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "target_eid": {
          "type": ["string", "null"]
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strip_block_fragments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ocrCorrectionOverride": {
      "type": "object",
      "title": "OcrCorrectionOverride",
      "additionalProperties": false,
      "required": ["doc_id", "page", "original_text", "corrected_text", "reason"],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "eid": {
          "type": ["string", "null"]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "original_text": {
          "type": "string",
          "minLength": 1
        },
        "corrected_text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clauseFix": {
      "type": "object",
      "title": "ClauseFix",
      "additionalProperties": false,
      "required": ["clause_id", "field", "value", "reason"],
      "properties": {
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "enum": [
            "title",
            "heading",
            "intro",
            "content",
            "wrap_up",
            "number",
            "native_number",
            "text",
            "level",
            "parent_id",
            "parent_eid",
            "verification",
            "verified_by",
            "verifications",
            "legal_status",
            "effective_from",
            "language",
            "cross_references",
            "tables",
            "summary_by_site",
            "notes_by_site",
            "ocr_status",
            "ocr_corrections",
            "type",
            "table_meta",
            "cells",
            "children"
          ]
        },
        "value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "annotationFix": {
      "type": "object",
      "title": "AnnotationFix",
      "additionalProperties": false,
      "required": ["annotation_id", "field", "value", "reason"],
      "properties": {
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "enum": ["value", "confidence", "verification"]
        },
        "value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "zoneTag": {
      "type": "object",
      "title": "ZoneTag",
      "additionalProperties": false,
      "required": ["clause_id", "zones", "reason"],
      "properties": {
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"],
          "default": "machine_checked"
        }
      }
    },
    "zoneFix": {
      "type": "object",
      "title": "ZoneFix",
      "additionalProperties": false,
      "required": ["zone_id", "set"],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:z[0-9a-zA-Z_-]+$"
        },
        "reason": {
          "type": "string"
        },
        "set": {
          "type": "object",
          "title": "ZoneFixSet",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "zone_code": {
              "type": "string",
              "minLength": 1
            },
            "zone_label": {
              "type": "string",
              "minLength": 1
            },
            "planning_district": {
              "type": ["string", "null"]
            },
            "sheet": {
              "type": ["string", "null"]
            },
            "verification": {
              "type": "string",
              "enum": [
                "unverified",
                "machine_checked",
                "human_verified",
                "rejected"
              ]
            },
            "verified_by": {
              "type": ["string", "null"]
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "mapCuration": {
      "type": "object",
      "title": "MapCuration",
      "additionalProperties": false,
      "required": ["map_id"],
      "properties": {
        "map_id": {
          "type": "string",
          "minLength": 1
        },
        "legend_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "MapLegendEntry",
            "additionalProperties": false,
            "required": ["zone_code", "zone_label", "rgb"],
            "properties": {
              "zone_code": {
                "type": "string",
                "minLength": 1
              },
              "zone_label": {
                "type": "string",
                "minLength": 1
              },
              "rgb": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        },
        "gcps": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "MapGcp",
            "additionalProperties": false,
            "required": ["id", "label", "pixel_x", "pixel_y"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "pixel_x": {
                "type": "number",
                "minimum": 0
              },
              "pixel_y": {
                "type": "number",
                "minimum": 0
              },
              "lon": {
                "type": "number"
              },
              "lat": {
                "type": "number"
              },
              "osm_query": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "amendmentLinkOverride": {
      "type": "object",
      "title": "AmendmentLinkOverride",
      "additionalProperties": false,
      "required": [
        "amending_clause",
        "target_clause",
        "action",
        "confidence",
        "verification"
      ],
      "properties": {
        "amending_clause": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "target_clause": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "action": {
          "type": "string",
          "enum": [
            "substitute",
            "insert_after",
            "insert_before",
            "omit",
            "modify",
            "renumber"
          ]
        },
        "effective_date": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        },
        "note": {
          "type": ["string", "null"]
        },
        "replacement_text": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
