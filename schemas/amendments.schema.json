{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/amendments.schema.json",
  "title": "JurisdictionAmendments",
  "description": "Amending effects and links between amending instructions and target nodes (Schema v1.3, Layer 3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jurisdiction", "links"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.3"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "effects": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/amendmentEffect"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amendmentLink"
      }
    }
  },
  "$defs": {
    "effectNodePayload": {
      "type": "object",
      "title": "EffectNodePayload",
      "additionalProperties": false,
      "required": ["eid", "type"],
      "properties": {
        "eid": {
          "type": "string",
          "minLength": 1
        },
        "native_number": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": ["string", "null"]
        },
        "intro": {
          "type": ["string", "null"]
        },
        "content": {
          "type": ["string", "null"]
        },
        "wrap_up": {
          "type": ["string", "null"]
        },
        "parent_eid": {
          "type": ["string", "null"]
        }
      }
    },
    "amendmentEffect": {
      "type": "object",
      "title": "AmendmentEffect",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "amending_doc",
        "amending_eid",
        "target_doc",
        "target_eid",
        "action",
        "new_nodes",
        "valid_from",
        "confidence",
        "applied",
        "verification"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "amending_doc": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "amending_eid": {
          "type": "string",
          "minLength": 1
        },
        "target_doc": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "target_eid": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "substitute",
            "insert_after",
            "insert_before",
            "omit",
            "renumber",
            "modify_text"
          ]
        },
        "new_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectNodePayload"
          }
        },
        "valid_from": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "applied": {
          "type": "boolean"
        },
        "unapplied_reason": {
          "type": ["string", "null"]
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        },
        "applies_in": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "amendmentLink": {
      "type": "object",
      "title": "AmendmentLink",
      "additionalProperties": false,
      "required": [
        "amending_clause",
        "target_clause",
        "action",
        "confidence",
        "verification"
      ],
      "properties": {
        "amending_clause": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "target_clause": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "amending_doc_id": {
          "type": ["string", "null"]
        },
        "target_doc_id": {
          "type": ["string", "null"]
        },
        "action": {
          "type": "string",
          "enum": [
            "substitute",
            "insert_after",
            "insert_before",
            "omit",
            "modify",
            "modify_text",
            "renumber"
          ]
        },
        "effective_date": {
          "type": ["string", "null"],
          "default": null
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        },
        "note": {
          "type": ["string", "null"]
        },
        "summary": {
          "type": ["string", "null"]
        },
        "applies_in": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
