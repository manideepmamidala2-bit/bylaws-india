{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/clause-tree.schema.json",
  "title": "ClauseTree",
  "description": "Structured faithful document tree in data/processed/<jurisdiction>/documents/<doc_id>.clauses.json (Schema v1.4, Layer 1 & Layer 3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "jurisdiction",
    "legal_status",
    "generated",
    "clauses"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "legal_status": {
      "type": "string",
      "enum": [
        "in_force",
        "draft",
        "superseded",
        "withdrawn",
        "status_unknown"
      ]
    },
    "chapter_eid": {
      "type": ["string", "null"],
      "default": null
    },
    "chapter_title": {
      "type": ["string", "null"],
      "default": null
    },
    "as_of_date": {
      "type": ["string", "null"],
      "default": null
    },
    "derived": {
      "type": ["boolean", "null"],
      "default": null
    },
    "total_clauses": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null
    },
    "total_tables": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null
    },
    "outline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clauseOutlineEntry"
      }
    },
    "generated": {
      "type": "object",
      "title": "ClauseTreeGenerated",
      "additionalProperties": false,
      "required": [
        "parser",
        "parser_version",
        "pipeline_version",
        "generated_at"
      ],
      "properties": {
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clauseNode"
      }
    }
  },
  "$defs": {
    "clauseCitation": {
      "type": "object",
      "title": "ClauseCitation",
      "additionalProperties": false,
      "required": ["doc_id", "page", "bbox", "text_excerpt"],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "text_excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tableSubColumnHeader": {
      "type": "object",
      "title": "TableSubColumnHeader",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": ["string", "null"]
        }
      }
    },
    "tableColumnHeader": {
      "type": "object",
      "title": "TableColumnHeader",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": ["string", "null"]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableSubColumnHeader"
          }
        }
      }
    },
    "tableFootnote": {
      "type": "object",
      "title": "TableFootnote",
      "additionalProperties": false,
      "required": ["marker", "text"],
      "properties": {
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "cell_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tableMeta": {
      "type": "object",
      "title": "TableMeta",
      "additionalProperties": false,
      "required": ["columns", "rows", "footnotes", "extraction"],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableColumnHeader"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableFootnote"
          }
        },
        "extraction": {
          "type": "string",
          "enum": ["complete", "failed"]
        },
        "page_image": {
          "type": ["string", "null"]
        },
        "gap_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "nodeVersion": {
      "type": "object",
      "title": "NodeVersion",
      "additionalProperties": false,
      "required": [
        "version_id",
        "valid_from",
        "valid_to",
        "source_doc",
        "legal_status",
        "citations"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": ["string", "null"]
        },
        "valid_to": {
          "type": ["string", "null"]
        },
        "heading": {
          "type": ["string", "null"]
        },
        "intro": {
          "type": ["string", "null"]
        },
        "content": {
          "type": ["string", "null"]
        },
        "wrap_up": {
          "type": ["string", "null"]
        },
        "cells": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "source_doc": {
          "type": "string",
          "minLength": 1
        },
        "source_eid": {
          "type": ["string", "null"]
        },
        "effect_id": {
          "type": ["string", "null"]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clauseCitation"
          }
        },
        "legal_status": {
          "type": "string",
          "enum": [
            "in_force",
            "draft",
            "superseded",
            "withdrawn",
            "status_unknown"
          ]
        },
        "omitted": {
          "type": "boolean",
          "default": false
        },
        "notes_by_site": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "ocrCorrection": {
      "type": "object",
      "title": "OcrCorrection",
      "additionalProperties": false,
      "required": ["original_text", "corrected_text", "page", "reason"],
      "properties": {
        "original_text": {
          "type": "string",
          "minLength": 1
        },
        "corrected_text": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clauseNode": {
      "type": "object",
      "title": "ClauseNode",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "record_id",
        "supersedes",
        "superseded_by",
        "legal_status",
        "number",
        "title",
        "level",
        "parent_id",
        "order",
        "text",
        "tables",
        "citations",
        "cross_references",
        "amended_by",
        "applies_to_zones",
        "verification"
      ],
      "properties": {
        "eid": {
          "type": "string",
          "minLength": 1
        },
        "native_number": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "enum": [
            "preface",
            "preamble",
            "part",
            "chapter",
            "section",
            "regulation",
            "bye_law",
            "clause",
            "subclause",
            "item",
            "paragraph",
            "proviso",
            "explanation",
            "note",
            "definition",
            "schedule",
            "annexure",
            "appendix",
            "form",
            "table",
            "table_row",
            "signature_block"
          ],
          "default": "clause"
        },
        "heading": {
          "type": ["string", "null"]
        },
        "intro": {
          "type": ["string", "null"]
        },
        "content": {
          "type": ["string", "null"]
        },
        "wrap_up": {
          "type": ["string", "null"]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "parent_eid": {
          "type": ["string", "null"]
        },
        "defines": {
          "type": ["string", "null"]
        },
        "defines_normalised": {
          "type": ["string", "null"]
        },
        "table_meta": {
          "anyOf": [
            { "$ref": "#/$defs/tableMeta" },
            { "type": "null" }
          ]
        },
        "cells": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeVersion"
          },
          "default": []
        },
        "clause_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+@v[0-9]+$"
        },
        "record_supersedes": {
          "type": ["string", "null"],
          "default": null
        },
        "record_superseded_by": {
          "type": ["string", "null"],
          "default": null
        },
        "record_change_reason": {
          "type": ["string", "null"],
          "default": null
        },
        "supersedes": {
          "type": ["string", "null"]
        },
        "superseded_by": {
          "type": ["string", "null"]
        },
        "legal_status": {
          "type": "string",
          "enum": [
            "in_force",
            "draft",
            "superseded",
            "withdrawn",
            "status_unknown"
          ]
        },
        "effective_from": {
          "type": ["string", "null"],
          "default": null
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": ["string", "null"]
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": ["en", "kn"],
          "default": "en"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clauseTable"
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clauseCitation"
          }
        },
        "cross_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amended_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applies_to_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        },
        "verified_by": {
          "type": ["string", "null"],
          "default": null
        },
        "omitted": {
          "type": "boolean",
          "default": false
        },
        "change_mark": {
          "anyOf": [
            { "$ref": "#/$defs/clauseChangeMark" },
            { "type": "null" }
          ],
          "default": null
        },
        "summary_by_site": {
          "type": ["string", "null"],
          "default": null
        },
        "notes_by_site": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "ocr_status": {
          "type": ["string", "null"],
          "enum": ["corrected", "unreadable_fragments", null],
          "default": null
        },
        "ocr_corrections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocrCorrection"
          },
          "default": []
        }
      }
    },
    "clauseOutlineEntry": {
      "type": "object",
      "title": "ClauseOutlineEntry",
      "additionalProperties": false,
      "required": [
        "eid",
        "clause_id",
        "number",
        "type",
        "level",
        "order",
        "page",
        "child_count",
        "table_count"
      ],
      "properties": {
        "eid": {
          "type": "string",
          "minLength": 1
        },
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": ["string", "null"]
        },
        "heading": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "parent_eid": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "child_count": {
          "type": "integer",
          "minimum": 0
        },
        "table_count": {
          "type": "integer",
          "minimum": 0
        },
        "chapter_file": {
          "type": ["string", "null"]
        },
        "changed_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "clauseChangeMark": {
      "type": "object",
      "title": "ClauseChangeMark",
      "additionalProperties": false,
      "required": ["label", "amending_doc", "amending_eid", "effective_date", "action"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "amending_doc": {
          "type": "string",
          "minLength": 1
        },
        "amending_eid": {
          "type": "string",
          "minLength": 1
        },
        "amending_clause_id": {
          "type": ["string", "null"]
        },
        "effective_date": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "original_text": {
          "type": ["string", "null"]
        },
        "original_heading": {
          "type": ["string", "null"]
        },
        "original_cells": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clauseTable": {
      "type": "object",
      "title": "ClauseTable",
      "additionalProperties": false,
      "required": ["table_id", "caption", "headers", "rows", "page"],
      "properties": {
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": ["string", "null"]
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
