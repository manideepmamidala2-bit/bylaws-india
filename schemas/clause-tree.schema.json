{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/clause-tree.schema.json",
  "title": "ClauseTree",
  "description": "Structured clause tree for a document in data/processed/<jurisdiction>/documents/<doc_id>.clauses.json (Phase 1 Plan §7.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "jurisdiction",
    "legal_status",
    "generated",
    "clauses"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^(_fixture-test|[a-z0-9]+(-[a-z0-9]+)*)$"
    },
    "legal_status": {
      "type": "string",
      "enum": ["in_force", "draft", "superseded", "withdrawn"]
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser",
        "parser_version",
        "pipeline_version",
        "generated_at"
      ],
      "properties": {
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clauseNode"
      }
    }
  },
  "$defs": {
    "clauseNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "number",
        "title",
        "level",
        "parent_id",
        "order",
        "text",
        "tables",
        "pages",
        "cross_references",
        "amended_by",
        "applies_to_zones",
        "verification"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": ["string", "null"]
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clauseTable"
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "cross_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amended_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applies_to_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        }
      }
    },
    "clauseTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "caption", "headers", "rows", "page"],
      "properties": {
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": ["string", "null"]
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
