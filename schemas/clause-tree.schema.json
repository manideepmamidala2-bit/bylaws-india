{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/clause-tree.schema.json",
  "title": "ClauseTree",
  "description": "Structured clause tree for a document in data/processed/<jurisdiction>/documents/<doc_id>.clauses.json (Schema v1.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "jurisdiction",
    "legal_status",
    "generated",
    "clauses"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "legal_status": {
      "type": "string",
      "enum": [
        "in_force",
        "draft",
        "superseded",
        "withdrawn",
        "status_unknown"
      ]
    },
    "generated": {
      "type": "object",
      "title": "ClauseTreeGenerated",
      "additionalProperties": false,
      "required": [
        "parser",
        "parser_version",
        "pipeline_version",
        "generated_at"
      ],
      "properties": {
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clauseNode"
      }
    }
  },
  "$defs": {
    "clauseCitation": {
      "type": "object",
      "title": "ClauseCitation",
      "additionalProperties": false,
      "required": ["doc_id", "page", "bbox", "text_excerpt"],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "text_excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clauseNode": {
      "type": "object",
      "title": "ClauseNode",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "record_id",
        "supersedes",
        "superseded_by",
        "legal_status",
        "number",
        "title",
        "level",
        "parent_id",
        "order",
        "text",
        "tables",
        "citations",
        "cross_references",
        "amended_by",
        "applies_to_zones",
        "verification"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+$"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:.+@v[0-9]+$"
        },
        "record_supersedes": {
          "type": ["string", "null"],
          "default": null
        },
        "record_superseded_by": {
          "type": ["string", "null"],
          "default": null
        },
        "record_change_reason": {
          "type": ["string", "null"],
          "default": null
        },
        "supersedes": {
          "type": ["string", "null"]
        },
        "superseded_by": {
          "type": ["string", "null"]
        },
        "legal_status": {
          "type": "string",
          "enum": [
            "in_force",
            "draft",
            "superseded",
            "withdrawn",
            "status_unknown"
          ]
        },
        "effective_from": {
          "type": ["string", "null"],
          "default": null
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": ["string", "null"]
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": ["en", "kn"],
          "default": "en"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clauseTable"
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clauseCitation"
          }
        },
        "cross_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amended_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applies_to_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        },
        "verified_by": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "clauseTable": {
      "type": "object",
      "title": "ClauseTable",
      "additionalProperties": false,
      "required": ["table_id", "caption", "headers", "rows", "page"],
      "properties": {
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": ["string", "null"]
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
