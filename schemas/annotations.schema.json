{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/annotations.schema.json",
  "title": "DocumentAnnotations",
  "description": "Stand-off character-span annotations for a structured document in data/processed/<jurisdiction>/documents/<doc_id>.annotations.json (Schema v1.4, Layer 2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "doc_id", "jurisdiction", "annotations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotationEntry"
      }
    }
  },
  "$defs": {
    "annotationTarget": {
      "type": "object",
      "title": "AnnotationTarget",
      "additionalProperties": false,
      "required": ["eid", "version_id", "field", "span", "span_text"],
      "properties": {
        "eid": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "enum": ["heading", "intro", "content", "wrap_up", "cell"]
        },
        "cell_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "span_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "annotationEntry": {
      "type": "object",
      "title": "AnnotationEntry",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "target",
        "kind",
        "value",
        "method",
        "confidence",
        "verification"
      ],
      "properties": {
        "annotation_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/annotationTarget"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cross_reference",
            "defined_term_use",
            "provision_type",
            "topic",
            "quantity",
            "zone_applicability"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": ["rule", "model", "person"]
        },
        "model_name": {
          "type": ["string", "null"]
        },
        "model_version": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "verification": {
          "type": "string",
          "enum": ["unverified", "machine_checked", "human_verified"]
        }
      }
    }
  }
}
