{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/document.schema.json",
  "title": "DocumentMetadata",
  "description": "Metadata and provenance record for an acquired raw document in data/raw/<jurisdiction>/<doc_id>.meta.json (Phase 1 Plan §7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "title",
    "issuing_authority",
    "layer",
    "role",
    "legal_status",
    "notified_date",
    "effective_from",
    "amends",
    "supersedes",
    "source_url",
    "retrieved_at",
    "sha256",
    "bytes",
    "page_count",
    "is_scanned"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "issuing_authority": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": ["national", "state", "planning", "municipal"]
    },
    "role": {
      "type": "string",
      "enum": ["base", "amendment", "regulation", "boundary", "reference"]
    },
    "legal_status": {
      "type": "string",
      "enum": ["in_force", "draft", "superseded", "withdrawn"]
    },
    "notified_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_from": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "amends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 10
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "page_count": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "is_scanned": {
      "type": "boolean"
    }
  }
}
