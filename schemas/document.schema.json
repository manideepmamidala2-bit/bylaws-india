{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/document.schema.json",
  "title": "DocumentMetadata",
  "description": "Metadata and provenance record for an acquired raw document in data/raw/<jurisdiction>/<doc_id>.meta.json (Schema v1.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "title",
    "issuing_authority",
    "layer",
    "role",
    "legal_status",
    "status_evidence",
    "licence_or_terms",
    "notified_date",
    "effective_from",
    "amends",
    "supersedes",
    "source_url",
    "retrieved_at",
    "sha256",
    "bytes",
    "page_count",
    "is_scanned"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "issuing_authority": {
      "type": "string",
      "minLength": 1
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "act",
        "rules",
        "regulations",
        "bye_laws",
        "amendment",
        "notification",
        "government_order",
        "circular",
        "map",
        "standard_reference"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "statute",
        "state_rules",
        "planning",
        "municipal",
        "orders",
        "overlay",
        "national_reference",
        "boundary"
      ]
    },
    "role": {
      "type": "string",
      "enum": ["base", "amendment", "regulation", "boundary", "reference"]
    },
    "legal_status": {
      "type": "string",
      "enum": [
        "in_force",
        "draft",
        "superseded",
        "withdrawn",
        "status_unknown"
      ]
    },
    "status_evidence": {
      "type": "object",
      "title": "DocumentStatusEvidence",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": ["string", "null"]
        },
        "quoted_line": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "notification_number": {
      "type": ["string", "null"]
    },
    "gazette_reference": {
      "type": ["string", "null"]
    },
    "superseded_by_document": {
      "type": ["string", "null"]
    },
    "licence_or_terms": {
      "type": "string",
      "minLength": 1
    },
    "text_rights": {
      "$ref": "#/$defs/documentTextRights"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["en", "kn"]
      }
    },
    "official_url": {
      "type": ["string", "null"]
    },
    "mirror_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "copies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentCopy"
      }
    },
    "cited_provisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentCitedProvision"
      }
    },
    "notified_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_from": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "amends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 10
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "page_count": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "is_scanned": {
      "type": ["boolean", "null"]
    }
  },
  "$defs": {
    "documentTextRights": {
      "type": "object",
      "title": "DocumentTextRights",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["full_text", "reference_only"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documentCopy": {
      "type": "object",
      "title": "DocumentCopy",
      "additionalProperties": false,
      "required": ["url", "path", "sha256", "retrieved_at"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "documentCitedProvision": {
      "type": "object",
      "title": "DocumentCitedProvision",
      "additionalProperties": false,
      "required": ["clause", "cited_by"],
      "properties": {
        "part": {
          "type": ["string", "null"]
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": ["string", "null"]
        },
        "cited_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "where_to_obtain": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
