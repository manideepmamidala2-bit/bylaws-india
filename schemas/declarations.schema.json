{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/declarations.schema.json",
  "title": "JurisdictionDeclarations",
  "description": "Self-declared coverage scope, known extraction gaps, unread/unobtainable documents, and contested status for a jurisdiction release (Schema v1.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jurisdiction",
    "not_modelled",
    "known_gaps",
    "unread_documents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "not_modelled": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knownGap"
      }
    },
    "unread_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unreadDocument"
      }
    },
    "unobtainable_documents": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/unobtainableDocument"
      }
    },
    "contested_status": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/contestedStatus"
      }
    },
    "building_relevant_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "knownGap": {
      "type": "object",
      "title": "KnownGap",
      "additionalProperties": false,
      "required": ["doc_id", "description"],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unreadDocument": {
      "type": "object",
      "title": "UnreadDocument",
      "additionalProperties": false,
      "required": ["title", "source_url", "reason"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unobtainableDocument": {
      "type": "object",
      "title": "UnobtainableDocument",
      "additionalProperties": false,
      "required": ["id", "title", "searched_sources", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "searched_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contestedStatus": {
      "type": "object",
      "title": "ContestedStatus",
      "additionalProperties": false,
      "required": ["doc_id", "title", "declared_status", "conflicting_evidence"],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "declared_status": {
          "type": "string",
          "const": "status_unknown"
        },
        "conflicting_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
