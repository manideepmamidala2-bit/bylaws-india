{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/geo-layers.schema.json",
  "title": "JurisdictionGeoLayers",
  "description": "Registry of official boundaries, master plan zone layers, derived overlays, and external reference map layers for a jurisdiction (Schema v1.4, Rule R14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jurisdiction", "layers"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geoLayerEntry"
      }
    }
  },
  "$defs": {
    "sheetOverlayConfig": {
      "type": "object",
      "title": "SheetOverlayConfig",
      "additionalProperties": false,
      "required": [
        "image_url",
        "bounds_wgs84",
        "sheet",
        "planning_district",
        "rmse_m"
      ],
      "properties": {
        "image_url": {
          "type": "string",
          "minLength": 1
        },
        "bounds_wgs84": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "planning_district": {
          "type": "string",
          "minLength": 1
        },
        "rmse_m": {
          "type": "number",
          "minimum": 0
        },
        "loo_rmse_m": {
          "type": ["number", "null"],
          "default": null
        },
        "max_residual_m": {
          "type": ["number", "null"],
          "default": null
        },
        "road_median_offset_m": {
          "type": ["number", "null"],
          "default": null
        },
        "road_p90_offset_m": {
          "type": ["number", "null"],
          "default": null
        }
      }
    },
    "geoLayerEntry": {
      "type": "object",
      "title": "GeoLayerEntry",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "title",
        "kind",
        "source",
        "method",
        "accuracy_m",
        "derived",
        "file",
        "external_url"
      ],
      "properties": {
        "layer_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "official_boundary",
            "master_plan_zone",
            "derived_overlay",
            "reference"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "accuracy_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "derived": {
          "type": "boolean"
        },
        "file": {
          "type": ["string", "null"]
        },
        "external_url": {
          "type": ["string", "null"]
        },
        "feature_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "default": null
        },
        "notes": {
          "type": ["string", "null"],
          "default": null
        },
        "sheet_overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/sheetOverlayConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    }
  }
}
