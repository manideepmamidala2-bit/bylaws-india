{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/zones.schema.json",
  "title": "ZonesFeatureCollection",
  "description": "GeoJSON FeatureCollection of zoning polygons in data/processed/<jurisdiction>/zones.geojson (Schema v1.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "features"],
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoneFeature"
      }
    }
  },
  "$defs": {
    "zoneFeatureProperties": {
      "type": "object",
      "title": "ZoneFeatureProperties",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "record_id",
        "supersedes",
        "superseded_by",
        "zone_code",
        "zone_label",
        "source_map",
        "georef_run",
        "extraction_method",
        "source_attribution",
        "area_sq_m",
        "verification",
        "notes"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:z[0-9a-zA-Z_-]+$"
        },
        "record_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:z[0-9a-zA-Z_-]+@v[0-9]+$"
        },
        "record_supersedes": {
          "type": ["string", "null"],
          "default": null
        },
        "record_superseded_by": {
          "type": ["string", "null"],
          "default": null
        },
        "record_change_reason": {
          "type": ["string", "null"],
          "default": null
        },
        "supersedes": {
          "type": ["string", "null"]
        },
        "superseded_by": {
          "type": ["string", "null"]
        },
        "zone_code": {
          "type": "string",
          "minLength": 1
        },
        "zone_label": {
          "type": "string",
          "minLength": 1
        },
        "planning_district": {
          "type": ["string", "null"],
          "default": null
        },
        "sheet": {
          "type": ["string", "null"],
          "default": null
        },
        "source_map": {
          "type": "string",
          "minLength": 1
        },
        "georef_run": {
          "type": "string",
          "minLength": 1
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "vector_pdf",
            "grid_georeferenced_raster",
            "osm_gcp_raster",
            "imported",
            "colour_segmentation",
            "road_outline_fallback",
            "manual"
          ]
        },
        "source_attribution": {
          "type": ["string", "null"]
        },
        "area_sq_m": {
          "type": "number",
          "minimum": 0
        },
        "verification": {
          "type": "string",
          "enum": [
            "unverified",
            "machine_checked",
            "human_verified",
            "rejected"
          ]
        },
        "verified_by": {
          "type": ["string", "null"],
          "default": null
        },
        "notes": {
          "type": ["string", "null"]
        }
      },
      "if": {
        "properties": {
          "extraction_method": {
            "const": "imported"
          }
        },
        "required": ["extraction_method"]
      },
      "then": {
        "properties": {
          "source_attribution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "zoneFeature": {
      "type": "object",
      "title": "ZoneFeature",
      "additionalProperties": false,
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "id": {
          "type": ["string", "integer"]
        },
        "geometry": {
          "$ref": "#/$defs/polygonOrMultiPolygon"
        },
        "properties": {
          "$ref": "#/$defs/zoneFeatureProperties"
        }
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonGeometry": {
      "type": "object",
      "title": "PolygonGeometry",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linearRing"
          }
        }
      }
    },
    "multiPolygonGeometry": {
      "type": "object",
      "title": "MultiPolygonGeometry",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/linearRing"
            }
          }
        }
      }
    },
    "polygonOrMultiPolygon": {
      "title": "ZoneGeometry",
      "oneOf": [
        {
          "$ref": "#/$defs/polygonGeometry"
        },
        {
          "$ref": "#/$defs/multiPolygonGeometry"
        }
      ]
    }
  }
}
