{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/zones.schema.json",
  "title": "ZonesFeatureCollection",
  "description": "GeoJSON FeatureCollection of zoning polygons in data/processed/<jurisdiction>/zones.geojson (Phase 1 Plan §7.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "features"],
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoneFeature"
      }
    }
  },
  "$defs": {
    "zoneFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "id": {
          "type": ["string", "integer"]
        },
        "geometry": {
          "$ref": "#/$defs/polygonOrMultiPolygon"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zone_id",
            "zone_code",
            "zone_label",
            "source_map",
            "georef_run",
            "extraction_method",
            "area_sq_m",
            "verification",
            "notes"
          ],
          "properties": {
            "zone_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:z[0-9a-zA-Z_-]+$"
            },
            "zone_code": {
              "type": "string",
              "minLength": 1
            },
            "zone_label": {
              "type": "string",
              "minLength": 1
            },
            "source_map": {
              "type": "string",
              "minLength": 1
            },
            "georef_run": {
              "type": "string",
              "minLength": 1
            },
            "extraction_method": {
              "type": "string",
              "enum": [
                "colour_segmentation",
                "road_outline_fallback",
                "manual"
              ]
            },
            "area_sq_m": {
              "type": "number",
              "minimum": 0
            },
            "verification": {
              "type": "string",
              "enum": [
                "unverified",
                "machine_checked",
                "human_verified",
                "rejected"
              ]
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonOrMultiPolygon": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/linearRing"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/linearRing"
                }
              }
            }
          }
        }
      ]
    }
  }
}
