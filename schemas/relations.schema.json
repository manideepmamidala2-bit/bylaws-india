{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/relations.schema.json",
  "title": "JurisdictionRelations",
  "description": "Schema v1.4 fourth layer: topics, cross-document relations, conflicts, statutory precedence, and institution succession.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jurisdiction", "topics", "succession", "relations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "public_visibility_rule": {
      "type": ["string", "null"],
      "default": null
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicDefinition"
      }
    },
    "succession": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/successionEntry"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationEntry"
      }
    }
  },
  "$defs": {
    "topicDefinition": {
      "type": "object",
      "title": "TopicDefinition",
      "additionalProperties": false,
      "required": ["id", "label", "description", "seed_phrases"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "seed_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "successionEntry": {
      "type": "object",
      "title": "SuccessionEntry",
      "additionalProperties": false,
      "required": [
        "id",
        "old_body",
        "new_body",
        "effective_date",
        "instrument_id",
        "instrument_title",
        "quoted_evidence",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "old_body": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_body": {
          "type": "string",
          "minLength": 1
        },
        "effective_date": {
          "type": "string"
        },
        "instrument_id": {
          "type": "string"
        },
        "instrument_title": {
          "type": "string"
        },
        "quoted_evidence": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "not_confirmed"],
          "default": "confirmed"
        },
        "page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "clause_eid": {
          "type": ["string", "null"]
        }
      }
    },
    "relationEntry": {
      "type": "object",
      "title": "RelationEntry",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from_doc",
        "from_eid",
        "to_doc",
        "to_eid",
        "from_span",
        "to_span",
        "method",
        "confidence",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "amends",
            "incorporates",
            "corporation_differs",
            "cross_document_reference",
            "definition_differs",
            "precedence",
            "same_topic",
            "numeric_differs"
          ]
        },
        "from_doc": {
          "type": "string",
          "minLength": 1
        },
        "from_eid": {
          "type": "string",
          "minLength": 1
        },
        "to_doc": {
          "type": "string",
          "minLength": 1
        },
        "to_eid": {
          "type": "string",
          "minLength": 1
        },
        "from_page": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "to_page": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null
        },
        "topic": {
          "type": ["string", "null"]
        },
        "parameter": {
          "type": ["string", "null"]
        },
        "from_span": {
          "type": "string",
          "minLength": 1
        },
        "to_span": {
          "type": "string",
          "minLength": 1
        },
        "precedence_span": {
          "type": ["string", "null"]
        },
        "applies_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string",
          "enum": ["rule", "embedding", "hybrid"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "confirmed",
            "not_yet_reviewed",
            "rejected",
            "human_verified"
          ]
        },
        "review_note": {
          "type": ["string", "null"],
          "default": null
        },
        "note": {
          "type": ["string", "null"]
        },
        "public_visible": {
          "type": "boolean",
          "default": false
        },
        "measured_precision": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "default": null
        },
        "parameters_incorporated": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "governing_doc": {
          "type": ["string", "null"],
          "default": null
        },
        "governing_value": {
          "type": ["string", "null"],
          "default": null
        }
      }
    }
  }
}
