{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bylaws-india.local/schemas/manifest.schema.json",
  "title": "ReleaseManifest",
  "description": "Published release manifest at Blob/static root manifest.json (Schema v1.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jurisdictions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.4"
    },
    "dataset_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Deterministic content-addressed build identifier across all public jurisdiction releases in this manifest."
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jurisdictionManifest"
      }
    }
  },
  "$defs": {
    "jurisdictionManifest": {
      "type": "object",
      "title": "JurisdictionManifest",
      "additionalProperties": false,
      "required": ["id", "name", "latest_release", "releases"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "test"],
          "default": "public"
        },
        "latest_release": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "register_documents": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Optional web path to pre-release source register JSON (e.g. /data/<id>/register/documents.json)."
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/releaseEntry"
          }
        }
      }
    },
    "releaseFiles": {
      "type": "object",
      "title": "ReleaseFiles",
      "additionalProperties": false,
      "required": [
        "documents",
        "clauses",
        "amendments",
        "zones",
        "boundary",
        "review_images"
      ],
      "properties": {
        "documents": {
          "type": "string",
          "minLength": 1
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amendments": {
          "type": "string",
          "minLength": 1
        },
        "consolidated": {
          "type": ["string", "null"]
        },
        "zones": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "gba_zones": {
          "type": ["string", "null"]
        },
        "wards": {
          "type": ["string", "null"]
        },
        "planning_districts": {
          "type": ["string", "null"]
        },
        "overlays": {
          "type": ["string", "null"]
        },
        "geo_layers": {
          "type": ["string", "null"]
        },
        "clause_zone_tags": {
          "type": ["string", "null"]
        },
        "sources_json": {
          "type": ["string", "null"]
        },
        "sources_csv": {
          "type": ["string", "null"]
        },
        "relations": {
          "type": ["string", "null"]
        },
        "graph": {
          "type": ["string", "null"]
        },
        "parameters": {
          "type": ["string", "null"]
        },
        "resolution": {
          "type": ["string", "null"]
        },
        "places": {
          "type": ["string", "null"]
        },
        "outlines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consolidated_outlines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "akn_xml": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_documents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "clauses"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "clauses": {
                "type": "string",
                "minLength": 1
              },
              "outline": {
                "type": ["string", "null"]
              },
              "annotations": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "review_images": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "releaseDrafts": {
      "type": "object",
      "title": "ReleaseDrafts",
      "additionalProperties": false,
      "required": ["clauses"],
      "properties": {
        "clauses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outlines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "releaseVerifierCredit": {
      "type": "object",
      "title": "ReleaseVerifierCredit",
      "additionalProperties": false,
      "required": ["verifier_name", "institution"],
      "properties": {
        "verifier_name": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "verified_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "releaseEntry": {
      "type": "object",
      "title": "ReleaseEntry",
      "additionalProperties": false,
      "required": [
        "version",
        "released_at",
        "licence",
        "download_zip",
        "sha256sums",
        "declarations",
        "files",
        "drafts",
        "changelog"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "dataset_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["published", "withdrawn"],
          "default": "published"
        },
        "withdrawn_reason": {
          "type": ["string", "null"]
        },
        "released_at": {
          "type": "string",
          "minLength": 10
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "download_zip": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "sha256sums": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "declarations": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "files": {
          "anyOf": [
            { "$ref": "#/$defs/releaseFiles" },
            { "type": "null" }
          ]
        },
        "drafts": {
          "anyOf": [
            { "$ref": "#/$defs/releaseDrafts" },
            { "type": "null" }
          ]
        },
        "changelog": {
          "type": "string"
        },
        "verifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseVerifierCredit"
          },
          "default": []
        }
      }
    }
  }
}
