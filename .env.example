# Vercel Blob read/write token for `bylaws publish`
BLOB_READ_WRITE_TOKEN=

# Optional public URL to manifest.json in Vercel Blob (defaults to /data/manifest.json locally)
NEXT_PUBLIC_MANIFEST_URL=

# Optional API key for LLMWhisperer comparison parser adapter
LLMWHISPERER_API_KEY=

# Optional LLM provider configuration for ambiguous clause boundary resolution
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
