# Optional explicit repository root path for the Python pipeline (falls back to upward search for bylaws.toml)
BYLAWS_ROOT=

# Publish target for `bylaws publish` ("local" or "blob")
DATA_TARGET=

# Vercel Blob read/write token for `bylaws publish --target blob`
BLOB_READ_WRITE_TOKEN=

# Vercel deploy hook URL triggered after `bylaws publish --target blob`
VERCEL_DEPLOY_HOOK_URL=

# Base URL for published datasets in the Next.js web app ("/data" locally, Blob URL in production)
NEXT_PUBLIC_DATA_BASE_URL=

# Optional API key for LLMWhisperer comparison parser adapter
LLMWHISPERER_API_KEY=
