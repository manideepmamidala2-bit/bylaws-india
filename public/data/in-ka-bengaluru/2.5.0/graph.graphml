    </node>
    <node id="rmp2015-zr:chp_10__cl_10.1__cl_25">
      <data key="label">D.R.C. shall be in prescribed form transferable only after due authentication by the Planning Authority / Local Body.</data>
      <data key="kind">clause</data>
      <data key="doc_id">rmp2015-zr</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="rmp2015-zr:chp_10__cl_10.1__cl_26">
      <data key="label">The Planning Authority (BDA when the TDR is generated by a plot / land located in BDA jurisdiction and BBMP when the TDR</data>
      <data key="kind">clause</data>
      <data key="doc_id">rmp2015-zr</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="rmp2015-zr:chp_10__cl_10.1__cl_27">
      <data key="label">If in, or in connection with, the exercise of its powers and discharge its functions by the Planning Authority / Local B</data>
      <data key="kind">clause</data>
      <data key="doc_id">rmp2015-zr</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
