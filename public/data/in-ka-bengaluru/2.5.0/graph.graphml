    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.1">
      <data key="label">Every building meant for human occupancy shall be provided with exits sufficient to permit safe escape of occupants, in </data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.2">
      <data key="label">In every building for multi family dwellings and all places of assembly, exits shall comply with the minimum requirement</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.3">
      <data key="label">All exits shall be free of obstructions.</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.4">
      <data key="label">No building shall be altered so as to reduce the number, and size of exits to less than that required.</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.5">
      <data key="label">Exits shall be clearly visible Routes to reach the exits shall be clearly marked and signs posted so as to guide the per</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.6">
      <data key="label">Wherever necessary, adequate and continuous illumination shall be provided for exits.</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.7">
      <data key="label">Fire fighting equipment shall be suitably located and clearly marked.</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
    <node id="bbl-2003:part_III__sec_21.0__cl_21.1__cl_21.1.8">
      <data key="label">Alarm devices shall be installed to ensure prompt evacuation of the persons concerned.</data>
      <data key="kind">clause</data>
      <data key="doc_id">bbl-2003</data>
      <data key="jurisdiction">in-ka-bengaluru</data>
    </node>
